{
  "name": "application-tracker",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  },
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "api/**/*.ts": "bash -c 'cd api && yarn eslint \"{src,apps,libs,test}/**/*.ts\"'",
    "frontend/**/*.{ts,tsx}": "bash -c 'cd frontend && yarn lint'",
    "chrome-extension/**/*.{ts,tsx}": "bash -c 'cd chrome-extension && yarn lint'"
  }
}
